{% doc %}
  @prompt
    Une mise en page éditoriale de style magazine
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-magazine-layout__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-layout__featured-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-magazine-layout__featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .ai-magazine-layout__featured-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    position: relative;
  }

  .ai-magazine-layout__featured-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-layout__featured-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-magazine-layout__featured-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
  }

  .ai-magazine-layout__featured-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .ai-magazine-layout__featured-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_font_size }}px;
    line-height: 1.5;
    margin: 0 0 16px;
    opacity: 0.9;
  }

  .ai-magazine-layout__featured-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    opacity: 0.8;
  }

  .ai-magazine-layout__sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-layout__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-magazine-layout__card-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    aspect-ratio: 16 / 9;
  }

  .ai-magazine-layout__card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
  }

  .ai-magazine-layout__card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-layout__card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-magazine-layout__card-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: {{ block.settings.category_color }};
  }

  .ai-magazine-layout__card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.card_text_color }};
  }

  .ai-magazine-layout__card-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.card_text_color }};
    opacity: 0.7;
  }

  .ai-magazine-layout__link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-magazine-layout__link-{{ ai_gen_id }}:hover .ai-magazine-layout__featured-title-{{ ai_gen_id }},
  .ai-magazine-layout__link-{{ ai_gen_id }}:hover .ai-magazine-layout__card-title-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-magazine-layout__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-magazine-layout__featured-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-magazine-layout__sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-magazine-layout__featured-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.featured_title_size }}px * 0.8);
    }

    .ai-magazine-layout__card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-layout__featured-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.featured_title_size }}px * 0.7);
    }

    .ai-magazine-layout__featured-excerpt-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-magazine-layout__container-{{ ai_gen_id }}">
    <div class="ai-magazine-layout__featured-{{ ai_gen_id }}">
      {% if block.settings.featured_article %}
        <a href="{{ block.settings.featured_article.url }}" class="ai-magazine-layout__link-{{ ai_gen_id }}">
          {% if block.settings.featured_article.image %}
            <img
              src="{{ block.settings.featured_article.image | image_url: width: 1200 }}"
              alt="{{ block.settings.featured_article.image.alt | escape }}"
              class="ai-magazine-layout__featured-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.featured_article.image.width }}"
              height="{{ block.settings.featured_article.image.height }}"
            >
          {% else %}
            <div class="ai-magazine-layout__featured-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-magazine-layout__featured-overlay-{{ ai_gen_id }}">
            {% if block.settings.show_category and block.settings.featured_article.tags.size > 0 %}
              <div class="ai-magazine-layout__featured-category-{{ ai_gen_id }}">
                {{ block.settings.featured_article.tags.first }}
              </div>
            {% endif %}
            <h2 class="ai-magazine-layout__featured-title-{{ ai_gen_id }}">
              {{ block.settings.featured_article.title }}
            </h2>
            {% if block.settings.show_excerpt and block.settings.featured_article.excerpt != blank %}
              <div class="ai-magazine-layout__featured-excerpt-{{ ai_gen_id }}">
                {{ block.settings.featured_article.excerpt | strip_html | truncate: 150 }}
              </div>
            {% endif %}
            {% if block.settings.show_date %}
              <div class="ai-magazine-layout__featured-meta-{{ ai_gen_id }}">
                {{ block.settings.featured_article.published_at | date: '%d %B %Y' }}
              </div>
            {% endif %}
          </div>
        </a>
      {% else %}
        <div class="ai-magazine-layout__featured-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-magazine-layout__empty-state-{{ ai_gen_id }}">
            Sélectionnez un article en vedette
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-magazine-layout__sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign article_key = 'article_' | append: i
          assign article = block.settings[article_key]
        %}
        <div class="ai-magazine-layout__card-{{ ai_gen_id }}">
          {% if article %}
            <a href="{{ article.url }}" class="ai-magazine-layout__link-{{ ai_gen_id }}">
              {% if article.image %}
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.image.alt | escape }}"
                  class="ai-magazine-layout__card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                >
              {% else %}
                <div class="ai-magazine-layout__card-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-magazine-layout__card-content-{{ ai_gen_id }}">
                {% if block.settings.show_category and article.tags.size > 0 %}
                  <div class="ai-magazine-layout__card-category-{{ ai_gen_id }}">
                    {{ article.tags.first }}
                  </div>
                {% endif %}
                <h3 class="ai-magazine-layout__card-title-{{ ai_gen_id }}">
                  {{ article.title }}
                </h3>
                {% if block.settings.show_date %}
                  <div class="ai-magazine-layout__card-meta-{{ ai_gen_id }}">
                    {{ article.published_at | date: '%d %B %Y' }}
                  </div>
                {% endif %}
              </div>
            </a>
          {% else %}
            <div class="ai-magazine-layout__card-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
            <div class="ai-magazine-layout__card-content-{{ ai_gen_id }}">
              <h3 class="ai-magazine-layout__card-title-{{ ai_gen_id }}">
                Sélectionnez un article {{ i }}
              </h3>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mise en page magazine",
  "settings": [
    {
      "type": "header",
      "content": "Article en vedette"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Article en vedette"
    },
    {
      "type": "header",
      "content": "Articles secondaires"
    },
    {
      "type": "article",
      "id": "article_1",
      "label": "Article 1"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "header",
      "content": "Affichage"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Afficher la catégorie",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Afficher l'extrait",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Afficher la date",
      "default": true
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur bureau",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Espacement vertical",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Espacement grille",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Rayon des bordures",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Superposition article vedette"
    },
    {
      "type": "range",
      "id": "overlay_padding",
      "label": "Espacement interne",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacité fond",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.7
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Couleur texte",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Cartes articles"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fond carte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Couleur texte",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Espacement interne",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Épaisseur bordure",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Couleur bordure",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "featured_title_size",
      "label": "Titre vedette",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Titre carte",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "category_font_size",
      "label": "Catégorie",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Couleur catégorie",
      "default": "#334fb4"
    },
    {
      "type": "range",
      "id": "excerpt_font_size",
      "label": "Extrait",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "label": "Métadonnées",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    }
  ],
  "presets": [
    {
      "name": "Mise en page magazine"
    }
  ]
}
{% endschema %}
